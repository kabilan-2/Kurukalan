PORT=3000
HOST=127.0.0.1
ADMIN_ID=admin
# Set a unique password before starting. No default password is enabled.
ADMIN_PASS=
COOKIE_SECURE=0
# Brevo API key and verified sender email; keep secrets out of GitHub.
BREVO_API_KEY=
EMAIL_FROM=
# Optional independent HMAC secret (recommended).
OTP_SECRET=

# Customer support recipients (or edit backend/support-config.js).
SUPPORT_EMAIL=
SUPPORT_MOBILE=

# Cloud PostgreSQL / Supabase session pooler connection string (server secret).
DATABASE_URL=
# Paste the provider root CA certificate if required, or use DATABASE_CA_FILE locally.
DATABASE_CA_CERT=
DATABASE_CA_FILE=
# Set to 1 for public deployment to forbid temporary local database fallback.
REQUIRE_CLOUD_DATABASE=0
